# Dependencies
node_modules/

# Downloaded Whisper ggml models (large — never commit)
models/
*.bin

# Raw recordings (audio is large and private)
recordings/

# Drop-In Recordings: keep the folder + readme, ignore the audio you drop in
Drop-In Recordings/*
!Drop-In Recordings/.gitkeep
!Drop-In Recordings/README.txt

# Generated transcripts (private meeting content) — keep the folder, ignore contents
transcripts/*
!transcripts/.gitkeep

# Local user config
.jamus/
*.local.json

# Compiled native helper (rebuilt via `npm run build:wasapi`)
native/*.exe

# Bundled FFmpeg for packaging (copy your own into vendor/ffmpeg/, see README)
vendor/

# electron-builder packaged output
release/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local video files (large, private) used for subtitle/transcribe-file testing
video/
